# ═══════════════════════════════════════════════════════
# GPSL ERP — Production Environment Variables
# ═══════════════════════════════════════════════════════

# ── Django Core ──
SECRET_KEY=change-this-to-a-random-50-char-string
DEBUG=False
IS_PRODUCTION=True

# ── Allowed Hosts (comma-separated, no spaces) ──
# Example: gpsl-automation.replit.app,www.gpsl.ng
ALLOWED_HOSTS=your-domain.replit.app,localhost,127.0.0.1

# ── CSRF Trusted Origins (comma-separated) ──
CSRF_TRUSTED_ORIGINS=https://your-domain.replit.app,https://www.gpsl.ng

# ── Admin Panel Hidden URL ──
# Change this! Don't use the default.
ADMIN_URL=gpsl-admin-panel-2026/

# ── Database ──
# Use 'postgresql' for production, 'sqlite' for local dev
DB_ENGINE=postgresql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host

# ── Email (SMTP) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# ── WhatsApp Business API (Meta / Twilio) ──
WHATSAPP_ENABLED=False
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ── Moniepoint POS ──
MONIEPOINT_ENABLED=False
MONIEPOINT_MERCHANT_ID=your-moniepoint-merchant-id
MONIEPOINT_API_KEY=your-moniepoint-api-key

# ── Supabase (for Render/production backups only) ──
# Replit does NOT need these — SQLite is used here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET=gpsl-backups

# ── Backup Email ──
BACKUP_EMAIL=your-email@example.com
DIRECTOR_EMAIL=your-email@example.com

# ── Cron Job Secret (for cron-job.org / external schedulers) ──
# Generate a random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=your-random-secret-token-here

# ── Brevo Verified Sender ──
# Must match a verified sender in Brevo Dashboard -> Senders
# Free tier: verify the email or use a Brevo-provided address
BREVO_SENDER_EMAIL=your-verified-sender@yourdomain.com